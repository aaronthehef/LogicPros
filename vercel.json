{
  "name": "logicproswebsite",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "functions": {
    "api/wordpress-proxy.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/logicpros",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "login.logicpros.ca"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/locations/fredericton/web-design", "destination": "/index.html" },
    { "source": "/locations/fredericton/cybersecurity", "destination": "/index.html" },
    { "source": "/locations/fredericton/managed-it", "destination": "/index.html" },
    { "source": "/locations/moncton/web-design", "destination": "/index.html" },
    { "source": "/locations/moncton/cybersecurity", "destination": "/index.html" },
    { "source": "/locations/moncton/managed-it", "destination": "/index.html" },
    { "source": "/locations/saint-john/web-design", "destination": "/index.html" },
    { "source": "/locations/saint-john/cybersecurity", "destination": "/index.html" },
    { "source": "/locations/saint-john/managed-it", "destination": "/index.html" },
    { "source": "/locations/(.*)", "destination": "/index.html" },
    { "source": "/services/(.*)", "destination": "/index.html" },
    { "source": "/contractors/(.*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/free-example", "destination": "/index.html" },
    { "source": "/logicpros", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/practiceshield", "destination": "/index.html" }
  ]
}