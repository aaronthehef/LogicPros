# WordPress Configuration
# Copy this file to .env and update with your actual credentials

# Your WordPress site URL
REACT_APP_WORDPRESS_SITE_URL=https://your-wordpress-site.com

# WordPress username (with API access)
REACT_APP_WORDPRESS_USERNAME=your-username

# WordPress Application Password (NOT your regular password)
# Generate this in WordPress admin: Users → Profile → Application Passwords
REACT_APP_WORDPRESS_APP_PASSWORD=your-application-password

# Optional: Override display settings
REACT_APP_WORDPRESS_POSTS_PER_PAGE=10
REACT_APP_WORDPRESS_EXCERPT_LENGTH=150